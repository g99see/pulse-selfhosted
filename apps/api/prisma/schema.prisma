// Схема Prisma для «Пульса». Фаза 0: минимальный срез сущностей из ТЗ §7
// (User + CheckIn). Фаза 1.1: аутентификация (сессии, подтверждение email),
// онбординг и первый счёт (ТЗ §3.1, §6).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  /// Почта необязательна (v3): нужна только для сброса пароля письмом.
  email           String?   @unique
  nickname        String    @unique
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")

  /// Роль пользователя (ТЗ §9 п.7): user | moderator | admin.
  /// Первый пользователь, созданный мастером первого запуска, — admin.
  role String @default("user")

  /// Цель чек-инов: сколько чек-инов в неделю (null — цель не задана).
  checkinWeeklyGoal Int? @map("checkin_weekly_goal")

  // Онбординг (ТЗ §3.1): валюта, часовой пояс, цели, уведомления, приватность.
  timezone              String    @default("UTC")
  currency              String    @default("RUB")
  locale                String    @default("ru")
  goals                 String[]  @default([])
  notificationsEnabled  Boolean   @default(true) @map("notifications_enabled")
  quietHoursStart       Int       @default(22) @map("quiet_hours_start")
  quietHoursEnd         Int       @default(8) @map("quiet_hours_end")
  onboardingStep        Int       @default(0) @map("onboarding_step")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  // Расписание чек-инов (ТЗ §3.3): 3 раза в день по умолчанию, настраивается 1–6.
  checkinTimesPerDay Int      @default(3) @map("checkin_times_per_day")
  checkinTimes       String[] @default(["09:00", "15:00", "21:00"]) @map("checkin_times")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  sessions                    Session[]
  verificationTokens          EmailVerificationToken[]
  accounts                    Account[]
  bankBalances                AccountBankBalance[]
  checkIns                    CheckIn[]
  categories                  Category[]
  userMerchants               UserMerchant[]
  transactions                Transaction[]
  budgets                     Budget[]
  notificationRules           NotificationRule[]
  dailyStats                  DailyStat[]
  userAchievements            UserAchievement[]
  savingsGoals                Goal[]
  goalDeposits                GoalDeposit[]
  recurringPayments           RecurringPayment[]
  externalIdentities          ExternalIdentity[]
  exchangeRates               ExchangeRate[]
  telegramLink                TelegramLink?
  telegramLinkCodes           TelegramLinkCode[]
  passwordTokens              PasswordToken[]
  checkInDrafts               CheckInDraft[]
  discordLink                 DiscordLink?
  daySummaryLink              DaySummaryLink?
  discordLinkCodes            DiscordLinkCode[]
  notificationChannelSettings NotificationChannelSetting[]
  notificationDeliveries      NotificationDelivery[]
  insights                    Insight[]

  /// Личный AI-ключ (ТЗ §3.9) — один на пользователя; приоритетнее общего.
  aiKey       UserAiKey?
  /// Учёт токенов AI по месяцам (ТЗ §3.9).
  aiUsage     AiUsage[]
  /// Предложения AI-помощника (ТЗ §3.9): бюджет, цель или напоминание.
  aiProposals AiProposal[]

  /// Личные токены доступа к открытому API (ТЗ §4).
  apiTokens         ApiToken[]
  /// Исходящие вебхуки (ТЗ §4).
  webhooks          Webhook[]
  /// Журнал доставок вебхуков (ТЗ §4).
  webhookDeliveries WebhookDelivery[]

  /// Капсулы времени пользователя (ТЗ §4, P2).
  timeCapsules TimeCapsule[]

  /// Привычки пользователя (ТЗ §4, P2).
  habits    Habit[]
  /// Отметки привычек по дням (ТЗ §4, P2).
  habitLogs HabitLog[]

  @@map("users")
}

/// Серверные сессии (ТЗ §6): хранится только SHA-256 от токена.
model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

/// Одноразовые токены подтверждения email (ТЗ §3.1, §6).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Счёт пользователя (ТЗ §7). Первый создаётся на шаге 4 онбординга.
model Account {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("card")
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  currency  String   @default("RUB")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions      Transaction[]        @relation("TransactionAccount")
  transfers         Transaction[]        @relation("TransferTarget")
  goals             Goal[]
  goalDeposits      GoalDeposit[]
  recurringPayments RecurringPayment[]
  bankBalances      AccountBankBalance[]

  @@index([userId])
  @@map("accounts")
}

/// Баланс счёта по данным банка (сверка): закрывающий баланс импортированной выписки
/// либо введённый вручную остаток карты на дату.
model AccountBankBalance {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId          String    @map("account_id")
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// 'statement' — из выписки, 'manual' — введён вручную.
  source             String
  balance            Decimal   @db.Decimal(14, 2)
  asOf               DateTime  @map("as_of") @db.Date
  /// Только для выписки: период и строки (для поиска расхождений).
  periodFrom         DateTime? @map("period_from") @db.Date
  periodTo           DateTime? @map("period_to") @db.Date
  rows               Json?
  /// Когда по этой выписке ушло уведомление о расхождении (один раз на выписку).
  mismatchNotifiedAt DateTime? @map("mismatch_notified_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([accountId, createdAt])
  @@index([userId])
  @@map("account_bank_balances")
}

model CheckIn {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood       Int
  energy     Int?
  stress     Int?
  sleepHours Float?   @map("sleep_hours")
  water      Int?
  steps      Int?
  tags       String[] @default([])
  note       String?
  /// Вечерний итог дня — одна строка (ТЗ §3.3).
  daySummary String?  @map("day_summary")
  /// Провал дня: morning / day / evening.
  slot       String?
  /// Фактический момент чек-ина; заполнение задним числом — до 24 часов (ТЗ §3.3).
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, occurredAt])
  @@index([userId, createdAt])
  @@map("check_ins")
}

/// Черновик многошагового чек-ина из мессенджера (ТЗ v2 §4): один активный на
/// пользователя и канал, живёт 30 минут. Логика шагов — packages/shared/checkin-dialog.
model CheckInDraft {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Канал диалога: telegram, discord…
  channel   String
  step      String
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  expiresAt DateTime @map("expires_at")

  @@unique([userId, channel])
  @@index([expiresAt])
  @@map("check_in_drafts")
}

/// Категория транзакции (ТЗ §7, v2 §8): userId = null — системная, иначе своя.
model Category {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String   @default("tag")
  color     String   @default("#6E6E7A")
  kind      String   @default("expense")
  isSystem  Boolean  @default(false) @map("is_system")
  /// Стабильный ключ стандартной категории (у своих — null): по нему справочник
  /// магазинов и импорт выбирают категорию по умолчанию.
  key       String?  @unique
  /// Родительская категория: подкатегории дерева категорий (ТЗ v2 §8).
  parentId  String?  @map("parent_id")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  createdAt DateTime @default(now()) @map("created_at")

  transactions      Transaction[]
  budgets           Budget[]
  recurringPayments RecurringPayment[]
  userMerchants     UserMerchant[]

  @@index([userId])
  @@index([parentId])
  @@map("categories")
}

/// Личный магазин пользователя (ТЗ v2 §9): название, категория и шаблон строки
/// в выписке. Имеет приоритет над общей базой магазинов при автоопределении.
model UserMerchant {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Шаблон строки в выписке (регулярное выражение) для автоопределения.
  pattern    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([categoryId])
  @@map("user_merchants")
}

/// Транзакция (ТЗ §7): доход, расход или перевод между счетами.
/// Перевод не считается расходом: type = 'transfer', transferAccountId — получатель.
model Transaction {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String    @map("account_id")
  account           Account   @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Cascade)
  categoryId        String?   @map("category_id")
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transferAccountId String?   @map("transfer_account_id")
  transferAccount   Account?  @relation("TransferTarget", fields: [transferAccountId], references: [id], onDelete: SetNull)
  type              String    @default("expense")
  amount            Decimal   @db.Decimal(14, 2)
  currency          String    @default("RUB")
  /// Курс валюты операции к основной валюте пользователя на дату (ТЗ §3.2).
  rate              Decimal   @default(1) @db.Decimal(18, 8)
  /// Сумма в основной валюте пользователя: amount × rate.
  amountBase        Decimal   @default(0) @map("amount_base") @db.Decimal(14, 2)
  /// Сумма зачисления при переводе между счетами разных валют.
  toAmount          Decimal?  @map("to_amount") @db.Decimal(14, 2)
  date              DateTime  @db.Date
  comment           String?
  /// Хеш строки импорта банковской выписки (ТЗ §3.2): идемпотентность повторного импорта.
  importHash        String?   @map("import_hash")
  /// Идентификатор операции в банке (колонка «Transaction ID»): при наличии — ключ идемпотентности импорта.
  externalId        String?   @map("external_id")
  /// Время операции по выписке «HH:MM» (колонка date хранит только день).
  bankTime          String?   @map("bank_time")
  /// Остаток на счёте по данным банка после этой операции (колонка «Balance»).
  bankBalance       Decimal?  @map("bank_balance") @db.Decimal(14, 2)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([userId, importHash])
  @@index([accountId, externalId])
  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
  @@map("transactions")
}

/// Бюджет на месяц по категории (ТЗ §3.2): month в формате «YYYY-MM».
model Budget {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month      String
  limit      Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, categoryId, month])
  @@index([userId, month])
  @@map("budgets")
}

/// Правило уведомлений (ТЗ §3.6, §7): тип, канал, расписание и тихие часы.
/// schedule — JSON вида { "times": ["09:00", "15:00", "21:00"] }.
model NotificationRule {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  channel         String   @default("telegram")
  schedule        Json     @default("{}")
  quietHoursStart Int      @default(22) @map("quiet_hours_start")
  quietHoursEnd   Int      @default(8) @map("quiet_hours_end")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([userId, type, channel])
  @@index([userId])
  @@map("notification_rules")
}

/// Агрегат по дню (ТЗ §3.4, §7, §6 «кеширование агрегатов по дням»):
/// траты, доходы, среднее настроение и число чек-инов. Пересчитывается лениво
/// при чтении статистики и хранится как кеш дневных значений.
model DailyStat {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  spent         Decimal  @default(0) @db.Decimal(14, 2)
  earned        Decimal  @default(0) @db.Decimal(14, 2)
  avgMood       Float?   @map("avg_mood")
  /// Средние по чек-инам, где поле заполнено; null — данных нет (ТЗ v2 §4).
  avgEnergy     Float?   @map("avg_energy")
  avgStress     Float?   @map("avg_stress")
  avgSleep      Float?   @map("avg_sleep")
  checkinsCount Int      @default(0) @map("checkins_count")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@map("daily_stats")
}

/// Подписка браузера на web push (ТЗ §3.6): endpoint и ключи шифрования.
/// Привязка Telegram-чата к аккаунту (ТЗ §3.6, §4): один чат — один аккаунт,
/// у пользователя один чат. Через неё бот пишет чек-ины и траты в чат.
model TelegramLink {
  id        String    @id @default(cuid())
  userId    String    @unique @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId    String    @unique @map("chat_id")
  username  String?
  linkedAt  DateTime  @default(now()) @map("linked_at")
  /// Бот заблокирован пользователем (403): доставка остановлена до новой активности.
  blockedAt DateTime? @map("blocked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("telegram_links")
}

/// Одноразовый токен привязки Telegram (ТЗ §3.6, v3 §6): TTL 15 минут, в БД только
/// SHA-256 от кода. После применения помечается used_at.
model TelegramLinkCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique @map("code_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([userId])
  @@map("telegram_link_codes")
}

/// Внешняя учётная запись (ТЗ §3.1, §7): вход через Google. Строки с provider =
/// telegram остались от удалённого входа через Telegram: по ним бот находит
/// пользователей без пароля и присылает им ссылку установки логина и пароля.
/// subject — стабильный идентификатор у провайдера (sub у Google, id у Telegram);
/// пара (provider, subject) уникальна.
model ExternalIdentity {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  subject   String
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, subject])
  @@index([userId])
  @@map("external_identities")
}

/// Настройки инстанса (ТЗ §9 п.7, §10): режим регистрации и отметка о том, что
/// мастер первого запуска завершён. Одна строка на инстанс (id = "instance").
model InstanceSettings {
  id               String    @id @default("instance")
  /// open — регистрация свободна; invite — только по приглашению (пока недоступно);
  /// closed — регистрация закрыта (POST /auth/register → 403 registration_closed).
  registrationMode String    @default("open") @map("registration_mode")
  setupCompletedAt DateTime? @map("setup_completed_at")

  // AI-помощник экземпляра (ТЗ §3.9): общий ключ, провайдер, модель и лимит.
  // Ключ хранится только зашифрованным AES-256-GCM (crypto/secret-box.ts).
  aiProvider          String? @map("ai_provider")
  aiApiKeyEncrypted   String? @map("ai_api_key_encrypted")
  aiApiKeyLast4       String? @map("ai_api_key_last4")
  aiBaseUrl           String? @map("ai_base_url")
  aiModel             String? @map("ai_model")
  aiMonthlyTokenLimit Int?    @map("ai_monthly_token_limit")

  /// Отпечаток каталога достижений, по которому уже выполнен тихий пересчёт
  /// (backfill) всех пользователей; при изменении каталога пересчёт повторяется.
  achievementsCatalogHash String? @map("achievements_catalog_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("instance_settings")
}

/// Одноразовый токен установки или сброса пароля (v3 §7): в БД только SHA-256.
/// purpose = reset — письмо или команда /password; setup — пользователь без пароля
/// (вход через Telegram в прошлом) задаёт логин и пароль. Срок жизни — 30 минут.
model PasswordToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([userId])
  @@map("password_tokens")
}

/// Курс валюты (ТЗ §3.2): одна единица base стоит rate единиц quote на дату.
/// Ручные курсы вводятся пользователем; source = provider — подтянуты с API.
/// Курс фиксируется в транзакции на дату операции (Transaction.rate).
model ExchangeRate {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  base      String
  quote     String
  rate      Decimal  @db.Decimal(18, 8)
  source    String   @default("manual")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date, base, quote])
  @@index([userId, date])
  @@map("exchange_rates")
}

/// Цель накоплений (ТЗ §3.2, §7): сумма, срок, картинка и приватность.
/// saved_amount меняется пополнениями (GoalDeposit) в одной транзакции.
model Goal {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  targetAmount Decimal   @map("target_amount") @db.Decimal(14, 2)
  savedAmount  Decimal   @default(0) @map("saved_amount") @db.Decimal(14, 2)
  deadline     DateTime? @db.Date
  /// Картинка: эмодзи-пресет или URL (файлы не загружаются).
  image        String?
  /// Необязательная связь со счётом-сбережениями (ТЗ §3.2).
  accountId    String?   @map("account_id")
  account      Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  currency     String    @default("RUB")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  deposits GoalDeposit[]

  @@index([userId])
  @@map("goals")
}

/// Пополнение цели (ТЗ §3.2): сумма, дата и необязательный счёт-источник.
/// История пополнений даёт фактический темп для прогноза даты достижения.
model GoalDeposit {
  id        String   @id @default(cuid())
  goalId    String   @map("goal_id")
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String?  @map("account_id")
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  @@index([goalId])
  @@index([userId, date])
  @@map("goal_deposits")
}

/// Инсайт-рекомендация на правилах (ТЗ §3.5, §7): текст задаётся ключом i18n и
/// параметрами, пользователь оценивает «полезно / не полезно». source = weekly —
/// элементы недельного разбора, periodKey делает генерацию идемпотентной.
model Insight {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Тип правила: category_spend_up, low_energy_streak, mood_with_sport,
  /// budget_exceeded, budget_suggestion, wellbeing_concern.
  type       String
  /// Ключ текста в i18n (строки не хранятся в БД).
  textKey    String    @map("text_key")
  /// Параметры подстановки в шаблон текста.
  params     Json      @default("{}")
  /// rule — из ленты правил, weekly — из недельного разбора.
  source     String    @default("rule")
  /// Ключ периода (ISO-неделя или день) — защищает от повторной генерации.
  periodKey  String?   @map("period_key")
  /// Действие предложения: { kind: "budget", categoryId, month, limit, ... }.
  action     Json?
  /// Когда предложение применили (создан бюджет).
  appliedAt  DateTime? @map("applied_at")
  /// Оценка пользователя: useful | not_useful.
  feedback   String?
  feedbackAt DateTime? @map("feedback_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([userId, type, periodKey])
  @@index([userId, createdAt])
  @@map("insights")
}

/// Регулярный платёж (ТЗ §3.2): аренда, подписки и другие периодические
/// списания. Расписание — частота + день (weekly: 1–7 Пн–Вс; monthly и yearly:
/// 1–31 с прижатием к концу месяца: 31-е → 30/28/29; month — только для yearly).
/// Время time_of_day считается в часовом поясе timezone (с учётом DST).
/// next_run_at — ближайшее списание, active — пауза/возобновление,
/// reminded_for — идемпотентность напоминания за 1 день.
model RecurringPayment {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  amount        Decimal   @db.Decimal(14, 2)
  type          String    @default("expense")
  accountId     String    @map("account_id")
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId    String?   @map("category_id")
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  frequency     String    @default("monthly")
  scheduleDay   Int       @map("schedule_day")
  scheduleMonth Int?      @map("schedule_month")
  timeOfDay     String    @default("10:00") @map("time_of_day")
  timezone      String    @default("UTC")
  nextRunAt     DateTime  @map("next_run_at")
  active        Boolean   @default(true)
  lastRunAt     DateTime? @map("last_run_at")
  remindedFor   DateTime? @map("reminded_for")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([userId, active, nextRunAt])
  @@map("recurring_payments")
}

/// Каталог достижений (ТЗ §2, §4; v3 §4): зеркало декларативного каталога из
/// @puls/shared (код, группа, метрика, уровни). Заполняется сервисом достижений
/// при старте приложения (идемпотентно); источник истины — файл каталога.
model Achievement {
  id        String   @id @default(cuid())
  code      String   @unique
  /// Условие выдачи: { group, metric, rarity, hidden, tiers: [{ level, threshold }] }.
  condition Json     @default("{}")
  /// Порядок отображения в сетке достижений.
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("achievements")
}

/// Полученный уровень достижения (v3 §4): одна строка на (пользователь, код,
/// уровень bronze|silver|gold) с датой получения. Тройка уникальна — выдача
/// идемпотентна и защищена от гонки на уровне БД (INSERT … ON CONFLICT DO NOTHING).
model UserAchievement {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code     String
  /// bronze | silver | gold.
  level    String   @default("bronze")
  earnedAt DateTime @default(now()) @map("earned_at")

  @@unique([userId, code, level])
  @@index([userId, earnedAt])
  @@map("user_achievements")
}

/// Личный API-ключ AI пользователя (ТЗ §3.9): один на пользователя, приоритетнее
/// общего ключа экземпляра. Сам ключ хранится только зашифрованным AES-256-GCM;
/// в интерфейс уходят лишь последние 4 символа (api_key_last4). Для
/// openai_compatible (Ollama/LM Studio) ключ может быть пустым, baseUrl обязателен.
model UserAiKey {
  userId          String   @id @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String
  apiKeyEncrypted String   @map("api_key_encrypted")
  apiKeyLast4     String?  @map("api_key_last4")
  baseUrl         String?  @map("base_url")
  model           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_ai_keys")
}

/// Учёт токенов AI по пользователю и месяцу (ТЗ §3.9): месяц в формате «YYYY-MM».
/// Строка одна на пару (user_id, month), накапливается upsert-ом. cost_usd —
/// примерная стоимость по тарифам shared/AI_PRICE_PER_MTOK (локальные — 0).
model AiUsage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String
  tokensIn  Int      @default(0) @map("tokens_in")
  tokensOut Int      @default(0) @map("tokens_out")
  costUsd   Decimal  @default(0) @map("cost_usd") @db.Decimal(14, 6)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, month])
  @@map("ai_usage")
}

/// Предложение AI-помощника (ТЗ §3.9): бюджет, цель или напоминание, которое
/// модель предлагает, но не сохраняет сама. Строка создаётся pending и ни на что
/// не влияет; «Применить» валидирует payload и создаёт сущность через её сервис.
/// result хранит { kind, id } созданного — повтор идемпотентен и не дублирует.
model AiProposal {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// budget | goal | reminder.
  kind      String
  /// Человекочитаемое описание для кнопки «Применить».
  summary   String
  /// Параметры действия: схема зависит от kind, валидируется при применении.
  payload   Json
  /// pending | applied.
  status    String    @default("pending")
  /// Что создано при «Применить»: { kind, id } — для идемпотентного повтора.
  result    Json?
  appliedAt DateTime? @map("applied_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("ai_proposals")
}

/// Личный токен доступа к открытому API (ТЗ §4). В базе хранится только
/// SHA-256 от токена; prefix (первые символы) — для показа в списке.
/// scopes: read | write; expires_at и revoked_at отзывают доступ.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique @map("token_hash")
  /// Первые символы токена для показа: puls_xxxxxxxx…
  prefix     String
  /// Области доступа: read | write (ТЗ §4).
  scopes     String[]  @default([])
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("api_tokens")
}

/// Подписка на исходящие вебхуки (ТЗ §4): адрес, зашифрованный секрет для
/// подписи (SecretBox) и список событий. Отключается флагом enabled.
model Webhook {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  /// Секрет подписи HMAC-SHA256, зашифрован AES-256-GCM (crypto/secret-box.ts).
  secret    String
  /// События: transaction.created, checkin.created, goal.milestone, achievement.earned.
  events    String[] @default([])
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([userId])
  @@map("webhooks")
}

/// Запись журнала доставки вебхука (ТЗ §4): статус, число попыток и ошибка.
/// Хранятся последние 50 на вебхук (лишние удаляются при вставке).
model WebhookDelivery {
  id        String   @id @default(cuid())
  webhookId String   @map("webhook_id")
  webhook   Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String
  /// pending | success | failed.
  status    String   @default("pending")
  attempts  Int      @default(0)
  lastError String?  @map("last_error")
  /// Тело события для повторной доставки.
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([webhookId, createdAt])
  @@index([userId])
  @@index([status, updatedAt])
  @@map("webhook_deliveries")
}

/**
 * ===== Семейный режим (ТЗ §4) =====
 */

/// Капсула времени (ТЗ §4, P2): письмо себе, которое открывается в заданный
/// момент вместе со снимком статистики за период [created_at, open_at]. Тело
/// хранится зашифрованным (SecretBox, суффикс *_encrypted), пока капсула
/// закрыта — API отдаёт только метаданные (title, open_at).
model TimeCapsule {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  /// Тело письма, зашифрованное AES-256-GCM (см. crypto/secret-box.ts).
  bodyEncrypted String    @map("body_encrypted")
  /// Снимок статистики за период [created_at, open_at], заполняется при открытии.
  snapshot      Json?
  openAt        DateTime  @map("open_at")
  openedAt      DateTime? @map("opened_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId, openAt])
  @@index([openedAt])
  @@map("time_capsules")
}

/// Привычка (ТЗ §4, P2): вода, спорт, чтение. goal_type = daily — цель каждый
/// день; weekly — per_week раз в неделю. archived прячет привычку в архив,
/// не удаляя историю отметок.
model Habit {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// Иконка — эмодзи из пресета (файлы не загружаются).
  icon      String   @default("✅")
  /// daily | weekly.
  goalType  String   @default("daily") @map("goal_type")
  /// Сколько раз в неделю для weekly (1–7); у daily не используется.
  perWeek   Int      @default(1) @map("per_week")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  logs HabitLog[]

  @@index([userId])
  @@map("habits")
}

/// Отметка привычки за день (ТЗ §4, P2): пара (habit_id, date) уникальна —
/// повторная отметка идемпотентна. done = false снимает отметку.
model HabitLog {
  id        String   @id @default(cuid())
  habitId   String   @map("habit_id")
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  done      Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_logs")
}

/// Привязка Discord-аккаунта (v2): одна привязка на пользователя и на Discord-аккаунт.
/// Доставка — личным сообщением в канал dmChannelId.
model DiscordLink {
  id            String    @id @default(cuid())
  userId        String    @unique @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  discordUserId String    @unique @map("discord_user_id")
  dmChannelId   String    @map("dm_channel_id")
  username      String?
  linkedAt      DateTime  @default(now()) @map("linked_at")
  /// Discord вернул 50007 (нельзя писать пользователю): доставка остановлена.
  blockedAt     DateTime? @map("blocked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("discord_links")
}

/// Одноразовый токен привязки Discord (v3 §6): TTL 15 минут, в БД только SHA-256 от кода.
model DiscordLinkCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique @map("code_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([userId])
  @@map("discord_link_codes")
}

/// Настройки канала доставки (telegram | discord): включён ли, расписание
/// {times, summaryTime}, тихие часы и необязательный свой часовой пояс.
model NotificationChannelSetting {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    String
  enabled    Boolean  @default(true)
  schedule   Json     @default("{}")
  quietStart Int      @default(22) @map("quiet_hours_start")
  quietEnd   Int      @default(8) @map("quiet_hours_end")
  timezone   String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, channel])
  @@map("notification_channel_settings")
}

/// Outbox уведомлений: запись ставится в очередь и уходит воркером с
/// экспоненциальным backoff (до 5 попыток). Статусы: queued | sent | failed | blocked.
model NotificationDelivery {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       String
  type          String
  payload       Json
  status        String    @default("queued")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@map("notification_deliveries")
}

/// Приватная ссылка «Итог дня» (/d/<токен>): в БД только SHA-256 токена,
/// сам токен показывается один раз при создании. Одна ссылка на пользователя.
model DaySummaryLink {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("day_summary_links")
}
