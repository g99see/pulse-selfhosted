// Схема Prisma для «Пульса». Фаза 0: минимальный срез сущностей из ТЗ §7
// (User + CheckIn). Фаза 1.1: аутентификация (сессии, подтверждение email),
// онбординг и первый счёт (ТЗ §3.1, §6).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  nickname        String    @unique
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")

  // Онбординг (ТЗ §3.1): валюта, часовой пояс, цели, уведомления, приватность.
  timezone             String    @default("UTC")
  currency             String    @default("RUB")
  locale               String    @default("ru")
  goals                String[]  @default([])
  notificationsEnabled Boolean   @default(true) @map("notifications_enabled")
  quietHoursStart      Int       @default(22) @map("quiet_hours_start")
  quietHoursEnd        Int       @default(8) @map("quiet_hours_end")
  profileVisibility    String    @default("private") @map("profile_visibility")
  onboardingStep       Int       @default(0) @map("onboarding_step")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  // Расписание чек-инов (ТЗ §3.3): 3 раза в день по умолчанию, настраивается 1–6.
  checkinTimesPerDay Int      @default(3) @map("checkin_times_per_day")
  checkinTimes       String[] @default(["09:00", "15:00", "21:00"]) @map("checkin_times")

  twoFaEnabled Boolean  @default(false) @map("two_fa_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  accounts           Account[]
  checkIns           CheckIn[]
  categories         Category[]
  transactions       Transaction[]
  budgets            Budget[]
  notificationRules  NotificationRule[]
  pushSubscriptions  PushSubscription[]

  @@map("users")
}

/// Серверные сессии (ТЗ §6): хранится только SHA-256 от токена.
model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

/// Одноразовые токены подтверждения email (ТЗ §3.1, §6).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Счёт пользователя (ТЗ §7). Первый создаётся на шаге 4 онбординга.
model Account {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("card")
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  currency  String   @default("RUB")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions Transaction[] @relation("TransactionAccount")
  transfers    Transaction[] @relation("TransferTarget")

  @@index([userId])
  @@map("accounts")
}

model CheckIn {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood       Int
  energy     Int?
  stress     Int?
  sleepHours Float?   @map("sleep_hours")
  water      Int?
  steps      Int?
  tags       String[] @default([])
  note       String?
  /// Вечерний итог дня — одна строка (ТЗ §3.3).
  daySummary String?  @map("day_summary")
  /// Провал дня: morning / day / evening.
  slot       String?
  /// Фактический момент чек-ина; заполнение задним числом — до 24 часов (ТЗ §3.3).
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, occurredAt])
  @@index([userId, createdAt])
  @@map("check_ins")
}

/// Категория транзакции (ТЗ §7): userId = null — системная, иначе своя.
model Category {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String   @default("tag")
  color     String   @default("#6E6E7A")
  kind      String   @default("expense")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")

  transactions Transaction[]
  budgets      Budget[]

  @@index([userId])
  @@map("categories")
}

/// Транзакция (ТЗ §7): доход, расход или перевод между счетами.
/// Перевод не считается расходом: type = 'transfer', transferAccountId — получатель.
model Transaction {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String   @map("account_id")
  account           Account  @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Cascade)
  categoryId        String?  @map("category_id")
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transferAccountId String?  @map("transfer_account_id")
  transferAccount   Account? @relation("TransferTarget", fields: [transferAccountId], references: [id], onDelete: SetNull)
  type              String   @default("expense")
  amount            Decimal  @db.Decimal(14, 2)
  currency          String   @default("RUB")
  date              DateTime @db.Date
  comment           String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
  @@map("transactions")
}

/// Бюджет на месяц по категории (ТЗ §3.2): month в формате «YYYY-MM».
model Budget {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month      String
  limit      Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, categoryId, month])
  @@index([userId, month])
  @@map("budgets")
}
/// Правило уведомлений (ТЗ §3.6, §7): тип, канал, расписание и тихие часы.
/// schedule — JSON вида { "times": ["09:00", "15:00", "21:00"] }.
model NotificationRule {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  channel         String   @default("web_push")
  schedule        Json     @default("{}")
  quietHoursStart Int      @default(22) @map("quiet_hours_start")
  quietHoursEnd   Int      @default(8) @map("quiet_hours_end")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([userId, type, channel])
  @@index([userId])
  @@map("notification_rules")
}


/// Подписка браузера на web push (ТЗ §3.6): endpoint и ключи шифрования.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("push_subscriptions")
}
