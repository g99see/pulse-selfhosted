// Схема Prisma для «Пульса». Фаза 0: минимальный срез сущностей из ТЗ §7
// (User + CheckIn). Фаза 1.1: аутентификация (сессии, подтверждение email),
// онбординг и первый счёт (ТЗ §3.1, §6).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  nickname        String    @unique
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")

  // Онбординг (ТЗ §3.1): валюта, часовой пояс, цели, уведомления, приватность.
  timezone             String    @default("UTC")
  currency             String    @default("RUB")
  locale               String    @default("ru")
  goals                String[]  @default([])
  notificationsEnabled Boolean   @default(true) @map("notifications_enabled")
  quietHoursStart      Int       @default(22) @map("quiet_hours_start")
  quietHoursEnd        Int       @default(8) @map("quiet_hours_end")
  profileVisibility    String    @default("private") @map("profile_visibility")
  onboardingStep       Int       @default(0) @map("onboarding_step")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  twoFaEnabled Boolean  @default(false) @map("two_fa_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  accounts           Account[]
  checkIns           CheckIn[]

  @@map("users")
}

/// Серверные сессии (ТЗ §6): хранится только SHA-256 от токена.
model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

/// Одноразовые токены подтверждения email (ТЗ §3.1, §6).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Счёт пользователя (ТЗ §7). Первый создаётся на шаге 4 онбординга.
model Account {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("card")
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  currency  String   @default("RUB")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model CheckIn {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood       Int
  energy     Int?
  stress     Int?
  sleepHours Float?   @map("sleep_hours")
  tags       String[] @default([])
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("check_ins")
}
