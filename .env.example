# SPDX-License-Identifier: AGPL-3.0-or-later
# «Пульс» — пример переменных окружения. Скопируйте в .env и заполните.
# Никогда не коммитьте .env с реальными секретами.

# --- PostgreSQL ---
POSTGRES_USER=puls
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=puls
# Для запуска API на хосте (dev) — localhost. В compose API использует имя сервиса postgres.
DATABASE_URL=postgresql://puls:change-me-in-production@localhost:5432/puls?schema=public

# --- Valkey (Redis-совместимый кеш и очереди BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- API ---
NODE_ENV=development
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Пульс

# --- Caddy / домены ---
DOMAIN=localhost
SANDBOX_DOMAIN=usercontent.localhost
ACME_EMAIL=admin@example.com
# --- Публикация Caddy на хост ---
# 80/443 уже заняты (Tailscale serve, другой reverse-proxy)? Укажите
# CADDY_BIND=127.0.0.1 либо смените порты через HTTP_PORT / HTTPS_PORT.
CADDY_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Публичный адрес сервиса — его используют compose и письма (WEB_APP_URL).
PUBLIC_ORIGIN=http://localhost
# PUBLIC_API_URL: "/" — API на том же origin, что и сайт (рекомендуется; работает по
# нескольким адресам сразу). Полный URL нужен, только если API на другом домене.
PUBLIC_API_URL=/

# --- Режим http в локальной сети (scripts/install.sh --http) ---
# CADDYFILE=Caddyfile.http отключает HTTPS: сайт на :80, песочница на :8080.
# COOKIE_SECURE: true/false; auto — по каждому запросу (X-Forwarded-Proto: https, его
# ставят порты Tailscale 8081/8082); пусто — по схеме PUBLIC_ORIGIN (https → true).
# SANDBOX_ORIGIN: полный origin песочницы; пусто — https://SANDBOX_DOMAIN.
# Пример: PUBLIC_ORIGIN=http://192.168.1.50  SANDBOX_ORIGIN=http://192.168.1.50:8080
CADDYFILE=Caddyfile
SANDBOX_HTTP_PORT=8080
COOKIE_SECURE=
SANDBOX_ORIGIN=

# --- Несколько адресов одной установки (LAN по http + Tailscale по https) ---
# См. docs-site/guide/quick-start.md, раздел про Tailscale.
# EXTRA_ORIGINS: доп. origin-ы сайта через пробел (CSP песочницы и CORS),
#   пример: https://puls.tailnet.ts.net
# EXTRA_SANDBOX_ORIGINS: доп. origin-ы песочницы для web (вшиваются при сборке),
#   пример: https://puls.tailnet.ts.net:8443
# TS_HTTP_PORT / TS_SANDBOX_PORT: порты Caddy на 127.0.0.1 для `tailscale serve`.
EXTRA_ORIGINS=
EXTRA_SANDBOX_ORIGINS=
TS_HTTP_PORT=8081
TS_SANDBOX_PORT=8082

# --- Почта (ТЗ §3.1, §10) ---
# Без SMTP письма подтверждения печатаются в лог (dev).
SMTP_URL=smtp://user:pass@mail.example.com:587
MAIL_FROM=Пульс <noreply@example.com>

# --- Web push (ТЗ §3.6): сгенерировать `pnpm --filter @puls/api vapid:generate` ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Шифрование секретов приложения (ТЗ §6): 32 байта AES-256-GCM в base64 ---
APP_ENCRYPTION_KEY=

# --- Внешние интеграции (ТЗ §3.1, §9) ---
# Вход через Google и Telegram.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# TELEGRAM_MODE: polling (по умолчанию в compose, публичный адрес не нужен) или
# webhook (нужен публичный HTTPS, вебхук регистрируется вручную через setWebhook
# с secret_token = TELEGRAM_WEBHOOK_SECRET).
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
# Провайдер курсов валют для финансов (ТЗ §3.2).
RATES_PROVIDER=

# --- Антивирус для HTML-страниц (ТЗ §3.8) ---
# host:port сервиса clamd (например, clamav:3310). Пусто — проверка отключена
# (noop-заглушка с понятным логом).
CLAMAV_HOST=

# --- Резервные копии (ТЗ §6, §10) ---
# Сервис backup в docker-compose: интервал и глубина ротации архивов.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# --- Прочее (Фаза 1+) ---
APP_VERSION=0.2.0
# Уведомления: планировщик в API (0 — выключить).
NOTIFICATIONS_SCHEDULER=1

# --- AI-помощник (Фаза 4, ТЗ §3.9) ---
# Отдельных переменных для ключей нет: ключи провайдеров
# (Anthropic/OpenAI/OpenRouter/любой OpenAI-совместимый, локальные Ollama/LM Studio)
# хранятся в БД зашифрованными. Личный ключ задаёт пользователь в настройках,
# общий ключ экземпляра — администратор. Для шифрования обязателен
# APP_ENCRYPTION_KEY (см. выше).
# Локальный провайдер (Ollama/LM Studio) включается профилем compose ai-local;
# в настройках AI укажите base URL, например http://host.docker.internal:11434/v1
# (Ollama на хосте) или http://ollama:11434/v1 (сервис в этом же compose).
# Порт Ollama на хосте для профиля ai-local:
OLLAMA_PORT=11434

# --- Семейный режим (Фаза 4, ТЗ §4) ---
# Общие счета и цели семьи, режим регистрации (открытая / по приглашениям /
# один пользователь) настраиваются в админке (InstanceSettings) — переменных
# окружения не требуют.

# --- Открытый API и вебхуки (Фаза 4, ТЗ §4) ---
# Разрешить доставку вебхуков на приватные адреса (127.0.0.1, 10/8, 192.168/16).
# По умолчанию 0 (запрещено) — защита от SSRF. Включайте для локальных
# интеграций (Home Assistant, n8n в домашней сети).
WEBHOOKS_ALLOW_PRIVATE=0
